{
  "name": "tech-assessment-reph",
  "type": "module",
  "devDependencies": {
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "chai": "^6.3.0",
    "mochawesome": "^8.1.1",
    "wdio-mochawesome-reporter": "^7.0.0"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.js",
    "api": "wdio run ./api.conf.js",
    "report": "mocha --reporter mochawesome",
    "test": "mocha ./test/specs/api/*.spec.js"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "mocha": {
    "diff": true,
    "extension": [
      "js"
    ],
    "package": "./package.json",
    "reporter": "mochawesome",
    "slow": "75",
    "timeout": "10000",
    "ui": "bdd",
    "watch-files": [
      "test/specs/api/*.spec.js"
    ],
    "watch-ignore": [
      "lib/vendor"
    ],
    "reporter-option": [
      "enableCode=false"
    ]
  },
  "blank": ""
}
